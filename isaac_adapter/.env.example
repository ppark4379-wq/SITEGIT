SITEGIT_API_URL=http://localhost:8000/api/v1
SITEGIT_PROJECT_ID=SASANG-001
SITEGIT_SITE_ASSET=isaac/assets/construction_site_demolition.usdz
# Approved Stage snapshots are versioned per branch. On startup the runner
# checks out this branch HEAD before accepting another Work Package.
SITEGIT_BRANCH=main
SITEGIT_RESTORE_BRANCH_HEAD=true
SITEGIT_STAGE_SCENARIO_ID=pipeline-demolition-v12
SITEGIT_EQUIPMENT_ASSET=
# X,Y and clearance above the local terrain surface (metres).
SITEGIT_EQUIPMENT_POSITION=-26.5,-30.5,0
SITEGIT_EQUIPMENT_GROUND_CLEARANCE_M=0.03
SITEGIT_EQUIPMENT_MASS_KG=18000
SITEGIT_EQUIPMENT_SETTLE_FRAMES=120
SITEGIT_EQUIPMENT_DRIVE_SPEED_MPS=1.8
SITEGIT_EQUIPMENT_TURN_RATE_DPS=38
SITEGIT_EQUIPMENT_ARRIVAL_TOLERANCE_M=0.35
SITEGIT_EQUIPMENT_FACING_TOLERANCE_DEG=3
SITEGIT_EQUIPMENT_FACE_TIMEOUT_S=8
SITEGIT_EXCAVATION_TRACK_MARGIN_M=0.75
# Rough scanned terrain may stop the tracks short; excavation already uses a
# 3 m stand-off, so <=1 m is still within the working envelope.
SITEGIT_EQUIPMENT_BLOCKED_DISTANCE_M=1.0
SITEGIT_EQUIPMENT_DRIVE_TIMEOUT_S=45
SITEGIT_EQUIPMENT_LINEAR_DAMPING=1.5
SITEGIT_EQUIPMENT_ANGULAR_DAMPING=6.0
SITEGIT_POST_EXCAVATION_SETTLE_FRAMES=180
# Fraction of the central soil-mesh height removed by one excavation (0.05-0.98).
SITEGIT_EXCAVATION_CUT_RATIO=0.9
SITEGIT_EQUIPMENT_PRIMS=/World/Equipment/EXC_001,/World/Equipment/EXC_002,/World/Equipment/EXC_003
SITEGIT_GROUP_EXCAVATION_ANIMATION_SECONDS=3.5
SITEGIT_GROUP_EXCAVATION_SCOOPS=1
SITEGIT_GROUP_PIPELINE_BACKFILL_SCOOPS=1
SITEGIT_DIGGABLE_ROOTS=/World/Diggable
# Preferred: read the authored LiDAR position from a clean/template USD without
# referencing that entire stage into the live scene.
SITEGIT_SENSOR_REFERENCE_USD=
SITEGIT_SENSOR_REFERENCE_PRIM=/World/LidarMount
# Fallback when no reference USD/Prim is configured. Values are relative to the
# excavator track-contact anchor in site axes and expressed in metres.
SITEGIT_SENSOR_MOUNT_OFFSET=0.705,-0.986,1.90
# Legacy camera fallback for deployments without an authored LiDAR mount.
SITEGIT_CAMERA_MOUNT_OFFSET=2.45,-0.986,2.15
# Preferred camera offset from the authored LiDAR (+X right, +Y forward, +Z up).
SITEGIT_CAMERA_OFFSET_FROM_LIDAR=0.65,0.10,0.25
SITEGIT_CAMERA_RESOLUTION=960,540
SITEGIT_CAMERA_PITCH_DEG=24
SITEGIT_CAMERA_LEVEL_HORIZON=true
SITEGIT_CAMERA_FOCAL_LENGTH_MM=12
SITEGIT_CAMERA_WARMUP_FRAMES=60
# Keep at most three RTX camera/IMU rigs live at once. Additional registered
# machines are initialized on demand so a fourth Hydra render product does not
# destabilize 12 GB presentation GPUs.
SITEGIT_SENSOR_RIG_MAX_ACTIVE=3
# Keep the photogrammetry mesh render-only and cook a cached 2 m physics mesh.
SITEGIT_TERRAIN_COLLISION_PROXY=true
SITEGIT_TERRAIN_COLLISION_RESOLUTION_M=2
# Visual backfill edges use a finer cached height field without increasing
# PhysX collision cooking cost.
SITEGIT_PIPELINE_HEIGHT_RESOLUTION_M=0.5
SITEGIT_COLLISION_COOKING_FRAMES=20
# Advance physics on every animation frame but render every Nth frame.  Raising
# this value speeds up the heavy photogrammetry Stage at the cost of smoothness.
SITEGIT_MOTION_RENDER_EVERY_N=2
SITEGIT_TERRAIN_PRIM=/World/SiteGitTerrainCollision
# Keep the LiDAR capability in evidence metadata without running thousands of
# PhysX raycasts or drawing green points during the construction animation.
SITEGIT_RUNTIME_LIDAR_ENABLED=false
SITEGIT_LIDAR_COLLISION_ROOTS=/World/SiteGitTerrainCollision,/World/Diggable,/World/SiteGit
SITEGIT_LIDAR_HORIZONTAL_FOV_DEG=130
SITEGIT_LIDAR_VERTICAL_MIN_DEG=-70
SITEGIT_LIDAR_VERTICAL_MAX_DEG=10
SITEGIT_LIDAR_HORIZONTAL_RAYS=101
SITEGIT_LIDAR_VERTICAL_RAYS=31
SITEGIT_LIDAR_MIN_RANGE_M=0.35
SITEGIT_LIDAR_MAX_RANGE_M=25
SITEGIT_LIDAR_DRAW_POINTS=true
SITEGIT_LIDAR_POINT_WIDTH_M=0.035
# Physical IMU created directly under the excavator RigidBody. Its XY position
# is the track centre; this height is measured above the top of the tracks.
SITEGIT_IMU_HEIGHT_ABOVE_TRACKS_M=0.45
SITEGIT_IMU_FREQUENCY_HZ=60
# Optional legacy/manual IMU path used only when no EquipmentSensorRig exists.
SITEGIT_IMU_PRIM=
SITEGIT_HEIGHT_GRID_CELL_M=0.5
SITEGIT_MIN_HEIGHT_CHANGE_M=0.05
SITEGIT_MAX_EXCAVATION_TARGET_SPAN_M=25
SITEGIT_CREATE_PIPELINE_BACKFILL=true
SITEGIT_PIPELINE_SOIL_BASECOLOR=E:\SiteGitData\isaac\assets\materials\demolition_soil_tile_diffuse.jpg
SITEGIT_PIPELINE_SOIL_NORMAL=E:\SiteGitData\isaac\assets\materials\demolition_soil_tile_normal.jpg
SITEGIT_CREATE_DEMO_SOIL_PILE=false
SITEGIT_DEMO_SOIL_PILE_PRIM=/World/Diggable/ZoneC_SoilPile_01
SITEGIT_DEMO_SOIL_PILE_POSITION=-26.5,-40.5
SITEGIT_DEMO_SOIL_PILE_SIZE=6,5,2.5
SITEGIT_DEMO_SOIL_PILE_ZONE=C
SITEGIT_USERNAME=manager
SITEGIT_PASSWORD=replace-manager-password
