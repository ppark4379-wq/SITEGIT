# ================================================================
# SiteGit runtime configuration — 실제 값은 루트 .env에 저장
# ================================================================
APP_NAME=SiteGit
APP_ENV=development

# 고정 URL / 서버
PUBLIC_URL=https://sitegit.example.com
PUBLIC_HOSTNAME=sitegit.example.com
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# 데이터 저장 위치 — DB·Evidence·Isaac·로그·백업
# 상대경로는 "저장소 루트" 기준으로 해석됩니다(실행 위치와 무관).
#   ./runtime          저장소 내부. SSD 없이 바로 실행할 때 (기본값)
#   ../SiteGitData     저장소와 데이터가 같은 외장 SSD에 있을 때 권장.
#                      다른 PC에서 드라이브 문자가 바뀌어도 동작합니다.
#   E:/SiteGitData     절대경로. 상시 운영 PC에 SSD를 고정할 때만.
# Windows는 forward slash 사용을 권장합니다.
SITEGIT_DATA_ROOT=./runtime
# 비워 두면 SITEGIT_DATA_ROOT/database/sitegit.db 사용
DATABASE_URL=

# Isaac Adapter
ISAAC_ADAPTER_ENABLED=false
ISAAC_ADAPTER_URL=http://localhost:8100

# 자연어 Work Package Compiler (Backend 전용, Git에 실제 키를 올리지 마세요)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=90

# 로그인 — 고정 URL 공개 전에 반드시 변경
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=sitegit_access_token
COOKIE_SECURE=false

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-admin-password
INITIAL_ADMIN_NAME=SiteGit 관리자
SEED_DEMO_USERS=true
INITIAL_MANAGER_USERNAME=manager
INITIAL_MANAGER_PASSWORD=replace-manager-password
INITIAL_MANAGER_NAME=김현장
INITIAL_VIEWER_USERNAME=viewer
INITIAL_VIEWER_PASSWORD=replace-viewer-password
INITIAL_VIEWER_NAME=현장 조회자

# Cloudflare remotely-managed tunnel을 쓸 때만 사용
CLOUDFLARE_TUNNEL_TOKEN=
